# Local development runs through `vercel dev` (middleware + functions). Verified behaviour:
#   - Vite reads VITE_* from .env or .env.local
#   - serverless functions and middleware read from .env (NOT .env.local) or exported shell vars
# So for local dev: copy this file to .env (gitignored). Never commit real values.

# PUBLIC (shipped to the browser by design — an OAuth Client ID is an identifier, not a secret).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
VITE_GOOGLE_CLIENT_ID=

# SERVER-ONLY. Long random value used to sign admin session cookies. Rotating it signs everyone out.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# SERVER-ONLY. Authorization. Prefer the Google account `sub` (stable numeric ID) once known.
# Bootstrap: leave ADMIN_GOOGLE_SUB empty and set ADMIN_GOOGLE_EMAIL; after the first successful
# login the function logs the sub. Set ADMIN_GOOGLE_SUB to it and remove ADMIN_GOOGLE_EMAIL.
ADMIN_GOOGLE_SUB=
ADMIN_GOOGLE_EMAIL=

# SERVER-ONLY. Upstash Redis (Vercel → Storage → Upstash for Redis → Connect Project). Vercel injects
# these automatically; locally run `vercel env pull .env`. Either naming scheme is accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
